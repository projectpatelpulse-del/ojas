# Copy to ojas_backend/.env on the VPS before pm2 start.
PORT=5001
NODE_ENV=production

MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/ojas?retryWrites=true&w=majority
JWT_SECRET=change-me-long-random-string

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
