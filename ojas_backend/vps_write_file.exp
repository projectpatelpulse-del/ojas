spawn ssh root@72.61.172.182 "cat > $target_path"
expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "R@dhe7906342450\r"
    }
}
send -- "$file_content"
send "\x04"
expect eof
